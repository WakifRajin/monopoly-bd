{
  "name": "monopoly-bd",
  "version": "0.2.0",
  "private": true,
  "description": "Bangladeshi Monopoly: a browser board game with local, AI and online play.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WakifRajin/monopoly-bd.git"
  },
  "homepage": "https://wakifrajin.github.io/monopoly-bd/",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "screenshots": "node tools/capture-screenshots.cjs",
    "build:3d": "esbuild scripts/board3d/main.js --bundle --minify --format=esm --target=es2020 --legal-comments=eof --outfile=scripts/board3d.min.js",
    "version:bump": "node tools/bump-version.cjs",
    "audit:ui": "node tools/ui-audit.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1"
  }
}
